{
  "name": "bs-panel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "setup": "prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
